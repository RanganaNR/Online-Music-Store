	<servlet>
	    <servlet-name>SignUpServlet</servlet-name>
	    <servlet-class>com.customer.SignUpServlet</servlet-class>
	</servlet>
	
	<servlet-mapping>
	    <servlet-name>SignUpServlet</servlet-name>
	    <url-pattern>/signup</url-pattern>
	</servlet-mapping>
	
	<!-- servelet for UPDATE-->
	
	<servlet>
	    <servlet-name>updateServlet</servlet-name>
