	</servlet>
	
	<servlet-mapping>
	    <servlet-name>updateServlet</servlet-name>
	    <url-pattern>/updateU</url-pattern> <!-- This is the URL pattern used in the form action -->
	</servlet-mapping>
	
	<!-- servelet for DELETE-->
			
	<servlet>
	    <servlet-name>DeleteServlet</servlet-name>
	    <servlet-class>com.customer.DeleteServlet</servlet-class>
	</servlet>
	
	<servlet-mapping>
	    <servlet-name>DeleteServlet</servlet-name>
	    <url-pattern>/deleteU</url-pattern> <!-- This is the URL pattern used in the form action -->
	</servlet-mapping>
	
